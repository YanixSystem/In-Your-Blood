---
import '../styles/global.css'; 
import Hero from '../components/Hero.astro';
import Myths from '../components/Myths.jsx';
import Requirements from '../components/Requirements.astro'; // Импортируем блок
import Checker from '../components/Checker.jsx'; // Импортируем наш виджет
import Perks from '../components/Perks.astro';
import Testimonials from '../components/Testimonials.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>В твоей крови | Проект о донорстве</title>
  </head>
  <body class="bg-orange-50 text-zinc-900 transition-colors duration-500 dark:bg-zinc-950 dark:text-white">
    
    <Hero />
    <Myths client:load /> 
    <Perks />
    <Requirements />
        <!-- Добавляем виджет и включаем JS -->
    <Checker client:load />
    <Testimonials />
    <Contacts />
    <Footer />

  </body>
</html>