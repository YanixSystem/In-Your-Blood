---
// src/components/Testimonials.astro
---

<section id="testimonials-section" class="py-24 relative z-10 overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="mx-auto max-w-2xl text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-5xl">
        Отзывы смельчаков
      </h2>
      <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">
        Реальные истории студентов и горожан, которые уже сделали этот шаг.
      </p>
    </div>

    <div class="mx-auto grid max-w-2xl grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      
      <!-- Отзыв 1 -->
      <div class="testimonial-card flex flex-col justify-between rounded-3xl bg-white dark:bg-zinc-800/50 p-8 shadow-sm ring-1 ring-zinc-200 dark:ring-zinc-700 backdrop-blur-sm">
        <p class="text-zinc-600 dark:text-zinc-300 mb-8 italic">
          «Сдавала кровь для пациента и также для входа в регистр доноров костного мозга. Осталась очень довольна! Кресла удобные, телевизор есть, чтобы не скучать. Коллектив очень отзывчивый, хороший. Во время донации находились рядом, разговаривали, уточняли самочувствие. В общем, все прошло замечательно!»
        </p>
        <div class="flex items-center gap-4 mt-auto">
          <!-- Место под фото -->
          <img src="/images/elina.png" alt="Элина Лощилина" class="h-14 w-14 rounded-full object-cover bg-zinc-200 dark:bg-zinc-700" />
          <div>
            <h4 class="font-bold text-zinc-900 dark:text-white">Элина Лощилина</h4>
            <p class="text-sm text-orange-500 dark:text-purple-400 font-medium">Первый раз донор</p>
          </div>
        </div>
      </div>

      <!-- Отзыв 2 -->
      <div class="testimonial-card flex flex-col justify-between rounded-3xl bg-white dark:bg-zinc-800/50 p-8 shadow-sm ring-1 ring-zinc-200 dark:ring-zinc-700 backdrop-blur-sm">
        <p class="text-zinc-600 dark:text-zinc-300 mb-8 italic">
          «Сдаю кровь с 18 лет, всегда все проходит на высоком уровне. Девочки в регистратуре очень отзывчивые. Затем иду на анализы, и с пальчика кровь берут совсем не больно. У врача все проходит максимально комфортно. А в зале процедура происходит безболезненно и довольно быстро.»
        </p>
        <div class="flex items-center gap-4 mt-auto">
          <!-- Место под фото -->
          <img src="/images/yulia.png" alt="Юлия Пашкова" class="h-14 w-14 rounded-full object-cover bg-zinc-200 dark:bg-zinc-700" />
          <div>
            <h4 class="font-bold text-zinc-900 dark:text-white">Юлия Пашкова</h4>
            <p class="text-sm text-orange-500 dark:text-purple-400 font-medium">Регулярный донор</p>
          </div>
        </div>
      </div>

      <!-- Отзыв 3 -->
      <div class="testimonial-card flex flex-col justify-between rounded-3xl bg-white dark:bg-zinc-800/50 p-8 shadow-sm ring-1 ring-zinc-200 dark:ring-zinc-700 backdrop-blur-sm">
        <p class="text-zinc-600 dark:text-zinc-300 mb-8 italic">
          «Рекомендую. Запись заранее через госуслуги либо по телефону. Вежливый персонал!»
        </p>
        <div class="flex items-center gap-4 mt-auto">
          <!-- Место под фото -->
          <img src="/images/aleksey.png" alt="Алексей Смирнов" class="h-14 w-14 rounded-full object-cover bg-zinc-200 dark:bg-zinc-700" />
          <div>
            <h4 class="font-bold text-zinc-900 dark:text-white">Алексей Смирнов</h4>
            <p class="text-sm text-orange-500 dark:text-purple-400 font-medium">Первый раз донор</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Плавное появление карточек при скролле
  gsap.from(".testimonial-card", {
    scrollTrigger: {
      trigger: "#testimonials-section",
      start: "top 80%",
      toggleActions: "play none none none"
    },
    y: 40,
    opacity: 0,
    duration: 0.8,
    stagger: 0.2,
    ease: "power3.out"
  });
</script>