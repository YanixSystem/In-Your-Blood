---
// src/components/Contacts.astro
---

<section id="contacts-section" class="py-24 relative z-10 flex justify-center px-6">
  <div class="contact-card w-full max-w-7xl rounded-3xl bg-zinc-200/60 dark:bg-zinc-800/60 p-8 md:p-12 shadow-sm ring-1 ring-zinc-300/50 dark:ring-zinc-700 backdrop-blur-md">
    
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
      
      <!-- Левая часть: Текст -->
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-5xl mb-8">
          Куда обратиться?
        </h2>
        
        <ul class="space-y-6 text-zinc-700 dark:text-zinc-300 text-lg">
          
          <!-- Адрес -->
          <li class="flex items-start gap-4">
            <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-200/50 dark:bg-purple-900/30 text-orange-600 dark:text-purple-400">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-zinc-900 dark:text-white">Адрес</p>
              <p>г. Новокузнецк, ул. Кутузова, д. 19</p>
            </div>
          </li>

          <!-- Режим работы -->
          <li class="flex items-start gap-4">
            <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-200/50 dark:bg-purple-900/30 text-orange-600 dark:text-purple-400">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-zinc-900 dark:text-white">Режим работы</p>
              <p>с 08:00 до 16:00</p>
              <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Приём на донацию с 08:00 до 14:30</p>
            </div>
          </li>

          <!-- Телефон -->
          <li class="flex items-start gap-4">
            <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-200/50 dark:bg-purple-900/30 text-orange-600 dark:text-purple-400">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.273-3.973-6.869-6.87l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-zinc-900 dark:text-white">Телефон регистратуры</p>
              <a href="tel:+73843796971" class="hover:text-orange-500 dark:hover:text-purple-400 transition-colors">
                8 (3843) 79-69-71
              </a>
            </div>
          </li>

        </ul>
      </div>

      <!-- Правая часть: Карта Яндекса -->
      <div class="h-100 w-full overflow-hidden rounded-2xl ring-1 ring-zinc-300 dark:ring-zinc-700 shadow-inner bg-zinc-300 dark:bg-zinc-800">
        <iframe 
          src="https://yandex.ru/map-widget/v1/?mode=search&text=г.+Новокузнецк,+ул.+Кутузова,+д.+19" 
          width="100%" 
          height="100%" 
          frameborder="0" 
          allowfullscreen="true"
          style="position:relative;"
          class="grayscale-[0.2] contrast-[0.9] dark:grayscale-[0.4] dark:invert-[0.9] dark:hue-rotate-180 transition-all duration-500"
        ></iframe>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Анимация выплывания окна контактов
  gsap.from(".contact-card", {
    scrollTrigger: {
      trigger: "#contacts-section",
      start: "top 85%",
      toggleActions: "play none none none"
    },
    y: 50,
    opacity: 0,
    duration: 0.8,
    ease: "power3.out"
  });
</script>
`