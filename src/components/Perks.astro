---
---
<!-- Убрали цвета фона, добавили id для триггера анимации -->
<section id="perks-section" class="py-24 relative z-10">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">Что ты получишь взамен?</h2>
      <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">
        Помимо спасенных жизней, донорство дает реальные льготы. Всё закреплено законом.
      </p>
    </div>

    <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      
      <!-- Добавили класс perk-card и opacity-0 (чтобы спрятать до анимации) -->
      <div class="perk-card flex flex-col rounded-3xl bg-white dark:bg-zinc-800/50 p-8 shadow-sm ring-1 ring-zinc-200 dark:ring-zinc-700 backdrop-blur-sm">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-100 dark:bg-purple-900/30 text-orange-600 dark:text-purple-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
        </div>
        <h3 class="text-xl font-bold">В день сдачи</h3>
        <ul class="mt-4 flex flex-col gap-3 text-sm text-zinc-600 dark:text-zinc-400">
          <li class="flex gap-2"><span>✅</span> <span>Официальное освобождение от учебы/работы.</span></li>
          <li class="flex gap-2"><span>✅</span> <span>Бесплатное питание или компенсация.</span></li>
          <li class="flex gap-2"><span>✅</span> <span>+1 дополнительный выходной.</span></li>
        </ul>
      </div>

      <div class="perk-card flex flex-col rounded-3xl bg-white dark:bg-zinc-800/50 p-8 shadow-sm ring-1 ring-zinc-200 dark:ring-zinc-700 backdrop-blur-sm">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-100 dark:bg-purple-900/30 text-orange-600 dark:text-purple-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold">Активным донорам</h3>
        <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400">Сдал кровь в максимальном объеме за год?</p>
        <ul class="mt-4 flex flex-col gap-3 text-sm text-zinc-600 dark:text-zinc-400">
          <li class="flex gap-2"><span>✅</span> <span>Первоочередное право на льготные путевки.</span></li>
        </ul>
      </div>

      <div class="perk-card flex flex-col rounded-3xl bg-linear-to-b from-orange-50 to-white dark:from-zinc-800/80 dark:to-zinc-900/80 p-8 shadow-sm ring-1 ring-orange-200 dark:ring-purple-700 relative overflow-hidden backdrop-blur-sm">
        <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-orange-400/20 dark:bg-purple-500/20 blur-2xl"></div>
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500 dark:bg-purple-600 text-white z-10">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold z-10">Почётный донор</h3>
        <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400 z-10">40 донаций крови</p>
        <ul class="mt-4 flex flex-col gap-3 text-sm text-zinc-600 dark:text-zinc-400 z-10">
          <li class="flex gap-2"><span>⭐</span> <span>Ежегодная денежная выплата.</span></li>
          <li class="flex gap-2"><span>⭐</span> <span>Отпуск в любое удобное время.</span></li>
          <li class="flex gap-2"><span>⭐</span> <span>Медицина по ОМС без очереди.</span></li>
        </ul>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Используем gsap.from() - анимируем ИЗ невидимого состояния со сдвигом вниз
  // к нормальному (родному) состоянию элементов
  gsap.from(".perk-card", {
    scrollTrigger: {
      trigger: "#perks-section",
      start: "top 85%", // Срабатывает, когда верх секции достигает 85% экрана
      toggleActions: "play none none none" // Анимация проиграется один раз
    },
    y: 50,             // Начинаем анимацию на 50px ниже
    opacity: 0,        // Начинаем с нулевой прозрачности
    duration: 0.8,
    stagger: 0.2,
    ease: "power3.out"
  });
</script>